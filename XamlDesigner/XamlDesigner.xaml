<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="XamlDesignerWindow"
        Title="PowerShell XAML Designer"
        Width="1400"
        Height="850"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem x:Name="MenuNew" Header="_New" InputGestureText="Ctrl+N"/>
                <MenuItem x:Name="MenuOpen" Header="_Open..." InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem x:Name="MenuSave" Header="_Save" InputGestureText="Ctrl+S"/>
                <MenuItem x:Name="MenuSaveAs" Header="Save _As..."/>
                <Separator/>
                <MenuItem x:Name="MenuExit" Header="E_xit"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem x:Name="MenuUndo" Header="_Undo" InputGestureText="Ctrl+Z"/>
                <MenuItem x:Name="MenuRedo" Header="_Redo" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem x:Name="MenuDelete" Header="_Delete selected control" InputGestureText="Del"/>
                <MenuItem x:Name="MenuDuplicate" Header="_Duplicate selected control" InputGestureText="Ctrl+D"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem x:Name="MenuValidate" Header="_Validate / Apply XAML" InputGestureText="F5"/>
                <MenuItem x:Name="MenuRefreshToolbox" Header="Refresh _Toolbox"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem x:Name="MenuGettingStarted" Header="_Getting Started"/>
                <MenuItem x:Name="MenuAbout" Header="_About"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="Designer status"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="DocumentText"
                           Text="Untitled.xaml"
                           AutomationProperties.Name="Current document"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235" MinWidth="170"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="350"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="320" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" Margin="6">
                <TabItem Header="Toolbox">
                    <DockPanel Margin="5">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Add a WPF control"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Margin="0,0,0,8"/>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Search"
                                   Margin="0,0,0,2"/>
                        <TextBox x:Name="ToolboxSearch"
                                 DockPanel.Dock="Top"
                                 Margin="0,0,0,7"
                                 ToolTip="Type part of a WPF control name, such as Button or TextBox."
                                 AutomationProperties.Name="Toolbox search"/>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Category"
                                   Margin="0,0,0,2"/>
                        <ComboBox x:Name="ToolboxCategory"
                                  DockPanel.Dock="Top"
                                  Margin="0,0,0,7"
                                  SelectedIndex="0"
                                  AutomationProperties.Name="Toolbox category">
                            <ComboBoxItem Content="Common"/>
                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="Controls"/>
                            <ComboBoxItem Content="Panels"/>
                            <ComboBoxItem Content="Shapes"/>
                            <ComboBoxItem Content="Decorators"/>
                            <ComboBoxItem Content="Other"/>
                        </ComboBox>
                        <Button x:Name="ButtonAddToolbox"
                                DockPanel.Dock="Bottom"
                                Content="Add selected control"
                                Margin="0,7,0,0"
                                Padding="8,4"
                                ToolTip="Adds the selected toolbox item to the current design container. You can also double-click the item."
                                AutomationProperties.Name="Add selected toolbox control"/>
                        <Border DockPanel.Dock="Bottom"
                                BorderThickness="1,1,1,0"
                                Padding="5"
                                Margin="0,7,0,0">
                            <TextBlock x:Name="ToolboxHelpText"
                                       Text="Select a control to see a short description."
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       AutomationProperties.Name="Toolbox control description"/>
                        </Border>
                        <ListBox x:Name="ToolboxList"
                                 DisplayMemberPath="DisplayName"
                                 ToolTip="Select a control, then drag it to the designer, double-click it, or use Add selected control."
                                 AutomationProperties.Name="WPF toolbox"/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Outline">
                    <DockPanel Margin="5">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="XAML document tree"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>
                        <TreeView x:Name="OutlineTree"
                                  AutomationProperties.Name="XAML document outline"/>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"/>

            <TabControl x:Name="MainTabs" Grid.Column="2" Margin="4,6,4,6">
                <TabItem Header="Designer">
                    <DockPanel>
                        <ToolBar DockPanel.Dock="Top">
                            <Button x:Name="ButtonDelete"
                                    Content="Delete"
                                    Padding="10,2"
                                    ToolTip="Delete the selected control (Del)"/>
                            <Button x:Name="ButtonDuplicate"
                                    Content="Duplicate"
                                    Padding="10,2"
                                    ToolTip="Duplicate the selected control (Ctrl+D)"/>
                            <Separator/>
                            <CheckBox x:Name="CheckSnapToGrid"
                                      Content="Snap 10 px"
                                      IsChecked="True"
                                      VerticalAlignment="Center"
                                      Margin="6,0"
                                      ToolTip="Snap mouse movement and toolbox drops to a 10-pixel grid."/>
                        </ToolBar>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <Grid Margin="18">
                                <Border x:Name="PreviewBorder"
                                        Background="White"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        MinWidth="500"
                                        MinHeight="340"
                                        AllowDrop="True"
                                        ToolTip="Design surface. Select controls here; double-click a control to create its common event handler.">
                                    <Grid x:Name="PreviewHost" Background="White"/>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
                <TabItem Header="XAML source">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6">
                            <Button x:Name="ButtonApplyXaml"
                                    Content="Validate / Apply"
                                    Padding="12,4"
                                    ToolTip="Parse the XAML and update the visual preview (F5)."/>
                            <Button x:Name="ButtonFormatXaml"
                                    Content="Format XML"
                                    Padding="12,4"
                                    Margin="6,0,0,0"
                                    ToolTip="Format indentation after confirming that the XML is valid."/>
                        </StackPanel>
                        <TextBox x:Name="XamlEditor"
                                 FontFamily="Consolas"
                                 FontSize="14"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 SpellCheck.IsEnabled="False"
                                 AutomationProperties.Name="XAML source editor"/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="PowerShell">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6">
                            <TextBlock Text="Generated regions are managed automatically. Keep your own logic outside those regions when possible."
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="ButtonValidateCode"
                                    Content="Validate PowerShell"
                                    Padding="12,4"
                                    Margin="12,0,0,0"
                                    ToolTip="Check PowerShell syntax without running the code."/>
                        </StackPanel>
                        <TextBox x:Name="CodeEditor"
                                 FontFamily="Consolas"
                                 FontSize="14"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 SpellCheck.IsEnabled="False"
                                 AutomationProperties.Name="PowerShell code editor"/>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"/>

            <DockPanel Grid.Column="4" Margin="6">
                <TextBlock x:Name="SelectedControlText"
                           DockPanel.Dock="Top"
                           Text="No control selected"
                           FontWeight="Bold"
                           FontSize="15"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"/>
                <TabControl>
                    <TabItem Header="Properties">
                        <DockPanel Margin="5">
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <TextBlock x:Name="PropertyNameText"
                                           Text="Select a property"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBox x:Name="PropertyValueText"
                                         Margin="0,4,0,2"
                                         AutomationProperties.Name="Property value"/>
                                <TextBlock x:Name="PropertyHelpText"
                                           Text="Select a property to see its type and suggested values."
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4"/>
                                <Button x:Name="ButtonApplyProperty"
                                        Content="Apply property"
                                        Padding="10,4"
                                        ToolTip="Apply the entered value and reload the preview."/>
                            </StackPanel>
                            <DataGrid x:Name="PropertyGrid"
                                      IsReadOnly="True"
                                      AutoGenerateColumns="False"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      AutomationProperties.Name="Properties">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Property" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="1.3*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Events">
                        <DockPanel Margin="5">
                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,6"
                                       Text="Common events appear first. Double-click an event to generate PowerShell code before ShowDialog."
                                       TextWrapping="Wrap"/>
                            <DataGrid x:Name="EventGrid"
                                      IsReadOnly="True"
                                      AutoGenerateColumns="False"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      AutomationProperties.Name="Events">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Event" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Declared by" Binding="{Binding DeclaringType}" Width="1.2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
